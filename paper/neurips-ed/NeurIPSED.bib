}

@misc{yuTSSNNTemporalShift2025,
  title = {{{TS-SNN}}: {{Temporal Shift Module}} for {{Spiking Neural Networks}}},
  shorttitle = {{{TS-SNN}}},
  author = {Yu, Kairong and Zhang, Tianqing and Xu, Qi and Pan, Gang and Wang, Hongwei},
  year = 2025,
  month = may,
  number = {arXiv:2505.04165},
  eprint = {2505.04165},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2505.04165},
  urldate = {2025-06-03},
  abstract = {Spiking Neural Networks (SNNs) are increasingly recognized for their biological plausibility and energy efficiency, positioning them as strong alternatives to Artificial Neural Networks (ANNs) in neuromorphic computing applications. SNNs inherently process temporal information by leveraging the precise timing of spikes, but balancing temporal feature utilization with low energy consumption remains a challenge. In this work, we introduce Temporal Shift module for Spiking Neural Networks (TS-SNN), which incorporates a novel Temporal Shift (TS) module to integrate past, present, and future spike features within a single timestep via a simple yet effective shift operation. A residual combination method prevents information loss by integrating shifted and original features. The TS module is lightweight, requiring only one additional learnable parameter, and can be seamlessly integrated into existing architectures with minimal additional computational cost. TS-SNN achieves state-of-the-art performance on benchmarks like CIFAR-10 (96.72\textbackslash\%), CIFAR-100 (80.28\textbackslash\%), and ImageNet (70.61\textbackslash\%) with fewer timesteps, while maintaining low energy consumption. This work marks a significant step forward in developing efficient and accurate SNN architectures.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Neural and Evolutionary Computing},
  annotation = {Read\_Status: New\\
Read\_Status\_Date: 2025-10-03T02:04:36.842Z},
