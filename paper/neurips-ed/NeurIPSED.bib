@misc{chenAgreeingStopReliable2023,
  title = {Agreeing to {{Stop}}: {{Reliable Latency-Adaptive Decision Making}} via {{Ensembles}} of {{Spiking Neural Networks}}},
  shorttitle = {Agreeing to {{Stop}}},
  author = {Chen, Jiechen and Park, Sangwoo and Simeone, Osvaldo},
  year = 2023,
