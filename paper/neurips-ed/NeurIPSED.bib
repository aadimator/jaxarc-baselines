@misc{rossbroichBreakingBalanceEncoding2025,
  title = {Breaking {{Balance}}: {{Encoding}} Local Error Signals in Perturbations of Excitation-Inhibition Balance},
  shorttitle = {Breaking {{Balance}}},
  author = {Rossbroich, Julian and Zenke, Friedemann},
  year = 2025,
