}

@misc{sabbellaPromiseSpikingNeural2025,
  title = {The {{Promise}} of {{Spiking Neural Networks}} for {{Ubiquitous Computing}}: {{A Survey}} and {{New Perspectives}}},
  shorttitle = {The {{Promise}} of {{Spiking Neural Networks}} for {{Ubiquitous Computing}}},
  author = {Sabbella, Hemanth and Mukherjee, Archit and Kandappu, Thivya and Dey, Sounak and Pal, Arpan and Misra, Archan and Ma, Dong},
  year = 2025,
