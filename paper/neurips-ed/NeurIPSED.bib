@misc{heilbronHigherlevelSpatialPrediction2025,
  title = {Higher-Level Spatial Prediction in Natural Vision across Mouse Visual Cortex},
  author = {Heilbron, Micha and de Lange, Floris P.},
  year = 2025,
  month = may,
  primaryclass = {New Results},
