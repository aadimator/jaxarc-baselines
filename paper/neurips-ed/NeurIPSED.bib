@article{trachMentalGraphsStructure2025,
  title = {Mental Graphs Structure the Storage and Retrieval of Visuomotor Associations},
  author = {Trach, Juliana E. and McDougle, Samuel D.},
  year = 2025,
  month = jun,
  journal = {Nature Human Behaviour},
  pages = {1--15},
  publisher = {Nature Publishing Group},
  issn = {2397-3374},
  doi = {10.1038/s41562-025-02217-2},
  urldate = {2025-06-03},
  abstract = {Much of human memory takes the form of cognitive graphs that allow us to relate and generalize knowledge. The influence of structured memory in the motor system is less clear. Here we examine how structured memory representations influence action selection when responses are retrieved from newly learned, hierarchical visuomotor maps. Human participants (N\,=\,182) learned visuomotor mappings with (or without) an imposed latent structure that linked visual stimulus features (for example, colour or shape) to intuitive motor distinctions, such as hands and pairs of fingers. In participants who learned structured visuomotor mappings, transitional response times indicated that retrieving the correct response from memory invoked the `traversal' of a structured mental graph. Forced-response experiments revealed similar computations within individual trials. Moreover, graph-like representations persisted even after multiple days of practice with the visuomotor mappings. Our results point to direct links between internal computations over structured memory representations and the preparation of movements.},
  copyright = {2025 The Author(s), under exclusive licence to Springer Nature Limited},
  langid = {english},
  keywords = {Human behaviour,Motor control},
  annotation = {Read\_Status: New\\
Read\_Status\_Date: 2025-10-03T02:04:36.894Z}
}

@misc{tschantzBayesianPredictiveCoding2025,
  title = {Bayesian {{Predictive Coding}}},
  author = {Tschantz, Alexander and Koudahl, Magnus and Linander, Hampus and Costa, Lancelot Da and Heins, Conor and Beck, Jeff and Buckley, Christopher},
  year = 2025,
  month = mar,
  number = {arXiv:2503.24016},
