  keywords = {Computer Science - Machine Learning},
  annotation = {Read\_Status: New\\
Read\_Status\_Date: 2025-10-03T02:04:36.865Z},
  file = {/Users/aadam/Zotero/storage/BES5ME2S/Zhang et al. - 2025 - Scaling and Beyond Advancing Spatial Reasoning in MLLMs Requires New Recipes.pdf;/Users/aadam/Zotero/storage/NBN4NXZN/2504.html}
}

@article{zhengBiologicallyInspiredSpatial2025,
