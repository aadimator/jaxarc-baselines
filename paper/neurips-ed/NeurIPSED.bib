@misc{zhuSurveyMultiAgentDeep2024,
  title = {A {{Survey}} of {{Multi-Agent Deep Reinforcement Learning}} with {{Communication}}},
  author = {Zhu, Changxi and Dastani, Mehdi and Wang, Shihan},
