@misc{batorskiNSANeurosymbolicARC2025,
  title = {{{NSA}}: {{Neuro-symbolic ARC Challenge}}},
  shorttitle = {{{NSA}}},
  author = {Batorski, Pawe{\l} and Brinkmann, Jannik and Swoboda, Paul},
